{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dtns/contracts/articles.schema.json",
  "title": "Raw Articles",
  "type": "object",
  "required": ["schema_version", "generated_at", "articles"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_run_id": { "type": "string" },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "title", "url", "collected_at"],
        "properties": {
          "source": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": ["rss", "atom", "github_release", "api", "html"]
          },
          "source_metadata": {
            "type": "object",
            "required": ["source_type", "source_priority", "source_name", "source_url"],
            "properties": {
              "source_type": { "type": "string", "enum": ["official_release", "engineering_blog", "developer_blog", "engine_case_study", "conference", "research_lab", "steam_devlog", "technical_media", "technical_synthesis", "discovery"] },
              "source_priority": { "type": "string", "enum": ["high", "medium", "low"] },
              "source_name": { "type": "string", "minLength": 1 },
              "source_url": { "type": "string", "format": "uri" },
              "is_discovery": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "summary": { "type": "string" },
          "author": { "type": "string" },
          "published_at": { "type": ["string", "null"], "format": "date-time" },
          "collected_at": { "type": "string", "format": "date-time" },
          "raw": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
